# Build stage
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy csproj files and restore dependencies
COPY ["src/StockSentiment.Api/StockSentiment.Api.csproj", "StockSentiment.Api/"]
COPY ["src/StockSentiment.Core/StockSentiment.Core.csproj", "StockSentiment.Core/"]
COPY ["src/StockSentiment.Infrastructure/StockSentiment.Infrastructure.csproj", "StockSentiment.Infrastructure/"]
RUN dotnet restore "StockSentiment.Api/StockSentiment.Api.csproj"

# Copy source code and build
COPY src/StockSentiment.Api/ StockSentiment.Api/
COPY src/StockSentiment.Core/ StockSentiment.Core/
COPY src/StockSentiment.Infrastructure/ StockSentiment.Infrastructure/
WORKDIR /src/StockSentiment.Api
RUN dotnet build "StockSentiment.Api.csproj" -c Release -o /app/build

# Publish stage
FROM build AS publish
RUN dotnet publish "StockSentiment.Api.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS final
WORKDIR /app
EXPOSE 8080
EXPOSE 8081

COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "StockSentiment.Api.dll"]

# Build stage
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy csproj files and restore dependencies
COPY ["src/StockSentiment.Web/StockSentiment.Web.csproj", "StockSentiment.Web/"]
COPY ["src/StockSentiment.Core/StockSentiment.Core.csproj", "StockSentiment.Core/"]
RUN dotnet restore "StockSentiment.Web/StockSentiment.Web.csproj"

# Copy source code and build
COPY src/StockSentiment.Web/ StockSentiment.Web/
COPY src/StockSentiment.Core/ StockSentiment.Core/
WORKDIR /src/StockSentiment.Web
RUN dotnet build "StockSentiment.Web.csproj" -c Release -o /app/build

# Publish stage
FROM build AS publish
RUN dotnet publish "StockSentiment.Web.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS final
WORKDIR /app
EXPOSE 8080
EXPOSE 8081

COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "StockSentiment.Web.dll"]
